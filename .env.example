# 이 파일을 복사해 .env 로 만들고 값을 채우세요:  cp .env.example .env

# MongoDB Atlas 연결 문자열
# mongodb+srv://<사용자>:<비밀번호>@<클러스터>/<DB이름>?retryWrites=true&w=majority&appName=<앱이름>
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/todo?retryWrites=true&w=majority&appName=Cluster0"

# Auth.js 세션 서명 키 (4단계에서 사용) — 생성:  pnpm dlx auth secret
AUTH_SECRET=""
