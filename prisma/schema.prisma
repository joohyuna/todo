// Prisma schema — 일간 ToDo 앱
// 반영: pnpm exec prisma db push   (MongoDB는 마이그레이션 없음)
// 생성: pnpm exec prisma generate  (postinstall 에서도 자동 실행)

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  // output 지정 안 함 → 기본 위치(node_modules)로 생성.
  // Next.js 16 + Turbopack 은 이 조합이 가장 안정적 (커스텀 output 은 파일 트레이싱 경고 발생).
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  nickname     String // 화면에 표시되는 닉네임 (회원가입 시 입력)
  passwordHash String // bcryptjs 해시 (평문 저장 안 함)
  todos        Todo[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Todo {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  done        Boolean   @default(false)
  completedAt DateTime? // [예약] done=true 전환 시 기록 (UI는 이후 단계)
  date        String // "YYYY-MM-DD" — 일간 버킷 키 (브라우저 로컬 날짜)
  order       Int       @default(0) // [예약] 같은 날짜 내 수동 정렬 (UI는 이후 단계)
  userId      String    @db.ObjectId
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, date])
}
